{
  "name": "soundforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "build:web": "vite build",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "ios:build": "npm run build:web && cap sync ios",
    "desktop:dev": "npm run build:web && electron electron/main.cjs",
    "desktop:dist": "npm run build:web && electron-builder"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
